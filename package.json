{
  "name": "tran-app",
  "version": "0.1.0",
  "private": true,
  "description": "A cross-platform money tracker note app built with Tauri 2, React, Tailwind CSS and shadcn/ui (Base UI)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "lint": "biome check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm knip && pnpm sg:check && pnpm build && pnpm size",
    "size": "size-limit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sg:check": "ast-grep scan",
    "find:cn": "ast-grep -p 'cn($$$ARGS)' src",
    "rename": "node scripts/rename-app.mjs",
    "tauri": "tauri",
    "release:macos": "bash scripts/release.sh macos",
    "release:windows": "bash scripts/release.sh windows",
    "release:android": "bash scripts/release.sh android",
    "release:ios": "bash scripts/release.sh ios",
    "release:all": "bash scripts/release.sh all"
  },
  "license": "MIT",
  "size-limit": [
    {
      "path": [
        "dist/assets/index-*.js",
        "dist/assets/index-*.css"
      ],
      "limit": "250 kB"
    }
  ],
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@emoji-mart/data": "^1.2.1",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-sql": "^2.6.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "emoji-mart": "^5.6.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.51.3",
    "@biomejs/biome": "^2.6.8",
    "@size-limit/preset-app": "^14.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/jest-dom": "^8.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "knip": "^6.47.0",
    "rollup-plugin-visualizer": "^7.1.3",
    "shadcn": "^4.23.0",
    "size-limit": "^14.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@10.28.1"
}
